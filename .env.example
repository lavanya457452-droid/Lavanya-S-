# ==========================================
# ComicCraft Offline Development Mode
# ==========================================

# No Gemini key: local story fallback is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local placeholder images are generated using Pillow.
IMAGE_PROVIDER=placeholder

# Not needed in placeholder mode.
HF_API_KEY=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

APP_NAME=ComicCraft